# CPU-only fallback -- uses the classical fallback depth/masking paths.
FROM python:3.11-slim AS base

RUN apt-get update && apt-get install -y \
    libgl1 libglx-mesa0 libglib2.0-0 libsm6 libxext6 libxrender-dev git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY pyproject.toml README.md LICENSE ./
COPY depthcraft/ ./depthcraft/
RUN pip install --no-cache-dir -e ".[dev]"

COPY config/ ./config/
COPY mvp_demo.py .
COPY scripts/ ./scripts/

EXPOSE 8000
CMD ["uvicorn", "depthcraft.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
